# Copy to `.env` and fill in real values.

ENVIRONMENT=development

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=256

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=shop_catalog
QDRANT_MEMORY_COLLECTION=conversation_memory

# Storage: supabase (production) | memory (tests / offline dev)
STORAGE_BACKEND=supabase
SUPABASE_URL=
SUPABASE_KEY=
# Direct Postgres connection string (Supabase dashboard -> Settings -> Database).
# When set, the server creates/updates tables automatically at startup.
# Otherwise run db/schema.sql once in the Supabase SQL editor.
# NOTE: special characters in the password (@ : / # ?) must be percent-encoded,
# e.g. p@ss -> p%40ss.
SUPABASE_DB_URL=
CATALOG_TABLE=catalog_products

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
AUTH_TOKEN_TTL_SECONDS=604800
# Require a logged-in account to use the chat endpoints (guests can still browse/cart)
REQUIRE_LOGIN_FOR_CHAT=true

# Comma-separated allowlist of frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
