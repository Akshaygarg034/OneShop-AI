# Copy to `.env` if the backend isn't on the default address.
# IPv4 avoids a conflicting service that may be bound to localhost's IPv6 address.
VITE_API_URL=http://127.0.0.1:8000

# Google Sign-In: the OAuth 2.0 Web application Client ID from Google Cloud Console.
# Must be the same value as GOOGLE_CLIENT_ID in the backend .env.
# Safe to expose to the browser. Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
